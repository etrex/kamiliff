<% messages = local_assigns.fetch(:messages) %>
<% messages = [messages] if messages.is_a?(Hash) %>
<% raise ArgumentError, "messages must be hashes" unless messages.is_a?(Array) && messages.all? { |message| message.is_a?(Hash) } %>
<script>
(async () => {
  try {
    const result = await Kamiliff.sendMessages(<%= raw json_escape(messages.to_json) %>, {close: true});
    document.dispatchEvent(new CustomEvent('kamiliff:message-result', {detail: result}));
  } catch (error) {
    document.dispatchEvent(new CustomEvent('kamiliff:message-error', {detail: {code: error.code || 'send_failed'}}));
  }
})();
</script>
